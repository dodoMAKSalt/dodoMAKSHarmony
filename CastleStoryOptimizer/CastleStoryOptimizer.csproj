<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Castle Story = Unity 5.6.5 / Mono, профиль .NET 3.5 -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>CastleStoryOptimizer</AssemblyName>
    <RootNamespace>CastleStoryOptimizer</RootNamespace>
    <Version>0.18.6</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Castle Story</GameDir>
    <Managed>$(GameDir)\Castle Story_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Networking"><HintPath>$(Managed)\UnityEngine.Networking.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MoonSharp.Interpreter"><HintPath>$(Managed)\MoonSharp.Interpreter.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brix.Core"><HintPath>$(Managed)\Brix.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(Managed)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Русификатор вшит в DLL (файлы собирает tools/build_russian.py) -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\language.csv" LogicalName="lang/language.csv" />
    <EmbeddedResource Include="Lang\meta.json" LogicalName="lang/meta.json" />
    <EmbeddedResource Include="Lang\csp_ru.txt" LogicalName="lang/csp_ru.txt" />
  </ItemGroup>

  <!-- После сборки кладём мод прямо в игру -->
  <Target Name="DeployToGame" AfterTargets="Build">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins\CastleStoryOptimizer" />
    <!-- Если игра запущена, DLL занята — не валим сборку, просто предупреждаем -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\CastleStoryOptimizer" ContinueOnError="WarnAndContinue" Retries="0" />
    <!-- Порт Castle Story Plus (Unity 6): свой BepInEx в CastleStoryPlus-Unity6 -->
    <MakeDir Directories="$(GameDir)\CastleStoryPlus-Unity6\BepInEx\plugins\CastleStoryOptimizer" Condition="Exists('$(GameDir)\CastleStoryPlus-Unity6\BepInEx\plugins')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\CastleStoryPlus-Unity6\BepInEx\plugins\CastleStoryOptimizer" Condition="Exists('$(GameDir)\CastleStoryPlus-Unity6\BepInEx\plugins')" ContinueOnError="WarnAndContinue" Retries="0" />
  </Target>

</Project>
